# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=DK CRM API
APP_VERSION=1.0.0
DEBUG=false

# "production" on the public server: hides /docs and /openapi.json, refuses to start with a placeholder
# SECRET_KEY, DEBUG=true or ALLOWED_ORIGINS=*, and never creates an admin with a default password.
# Keep "development" on your own computer.
ENVIRONMENT=development
# Production only: set true to keep /docs reachable.
ENABLE_API_DOCS=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local development — no server required)
DATABASE_URL=sqlite+aiosqlite:///./crm.db

# PostgreSQL (production — uncomment, fill in credentials, and comment out SQLite line above)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/dk_crm

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-use-a-strong-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Initial admin user (seed_admin.py) ─────────────────────────────────────────
# Required — the seed script exits with an error if either is unset.
# It only ever creates the account once: if a user with this email/username
# already exists, the script skips creation and leaves the existing password
# untouched, so changing these later does not rotate an already-seeded admin.
# Generate a strong password with: python -c "import secrets; print(secrets.token_urlsafe(18))"
DEFAULT_ADMIN_EMAIL=changeme@example.com
DEFAULT_ADMIN_PASSWORD=changeme-use-a-strong-password
# Optional — default to "admin" / "System Administrator" if unset.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_FULL_NAME=System Administrator

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins. In production list only your real HTTPS domains.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","http://127.0.0.1:8000"]

# ── Notifications: WhatsApp Business API (primary channel) ────────────────────
# Leave blank to disable WhatsApp sends — the service falls back to email automatically.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0

# ── Notifications: SMTP email (fallback channel) ───────────────────────────────
# Leave SMTP_HOST blank to disable email sends.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@dkservice.com
SMTP_USE_TLS=true

# ── IoT Telemetry (forklift GPS/hour-meter device webhook) ────────────────────
# Required by devices/simulators posting to POST /api/v1/iot/webhook (X-API-Key header).
# Leave blank to disable the webhook (it responds 503 while unset).
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
IOT_WEBHOOK_API_KEY=

# Shared secret for the public storefront server; must equal CRM_STOREFRONT_TOKEN in storefront/.env.local.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))". Empty disables the storefront endpoints.
STOREFRONT_INTEGRATION_TOKEN=
