{
  "$schema": "https://unpkg.com/wrangler@4.151.0/config-schema.json",
  // Staff CRM screens (frontend/) on Cloudflare Workers. Lives at the repository root so the
  // Cloudflare Git build (build command `npm run build`, deploy command `npx wrangler deploy`) finds it.
  // The name must match the Worker connected to this repository in the Cloudflare dashboard.
  "name": "dk-lao-services",
  "main": "frontend/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These paths always reach the Worker (the backend proxy) instead of the SPA shell.
    "run_worker_first": ["/api/*", "/uploads/*", "/health", "/livez"]
  },
  // Keeps a free Render backend awake (see frontend/worker/index.ts).
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    // The backend's public address. Change it here, or override it in the Cloudflare dashboard.
    "BACKEND_URL": "https://dk-crm-api.onrender.com"
  },
  "observability": { "enabled": true }
}
