{
  "$schema": "https://unpkg.com/wrangler@4.151.0/config-schema.json",
  // Staff CRM screens (frontend/) on Cloudflare Workers. Lives at the repository root so the
  // Cloudflare Git build (build command `npm run build`, deploy command `npx wrangler deploy`) finds it.
  // The name must match the Worker connected to this repository in the Cloudflare dashboard.
  "name": "dk-lao-services",
  "main": "frontend/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // The Render service that now serves screens and API; this Worker only redirects to it.
    "BACKEND_URL": "https://dk-crm-web.onrender.com"
  },
  // The Worker was once deployed with the Containers option (wrangler.containers.jsonc, tag v1). This drops
  // its leftover Durable Object class so the default deploy is accepted again.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CrmBackend"] },
    { "tag": "v2", "deleted_classes": ["CrmBackend"] }
  ],
  "observability": { "enabled": true }
}
