{
  "$schema": "https://unpkg.com/wrangler@4.151.0/config-schema.json",
  // Staff CRM screens on Cloudflare Workers: https://dk-crm.<account subdomain>.workers.dev
  // Deploy with `npm run cf:deploy` (builds with the same-origin API path /api/v1 first).
  "name": "dk-crm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These paths always reach the Worker (the backend proxy) instead of the SPA shell.
    "run_worker_first": ["/api/*", "/uploads/*", "/health", "/livez"]
  },
  // Keeps a free Render backend awake (see worker/index.ts).
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    // The backend's public address. Change it here, or override it in the Cloudflare dashboard.
    "BACKEND_URL": "https://dk-crm-api.onrender.com"
  },
  "observability": { "enabled": true }
}
