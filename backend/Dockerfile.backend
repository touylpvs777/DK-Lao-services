FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# curl is used by the compose health check.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY app ./app
COPY alembic.ini ./
COPY migrations ./migrations

# Run as a normal user. Uploaded images live in /app/uploads (mount a volume there to keep them).
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/uploads/images \
    && chown -R appuser:appuser /app
USER appuser

ENV PORT=8001
EXPOSE 8001

# Settings come from the environment (docker-compose passes backend/.env and overrides).
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
