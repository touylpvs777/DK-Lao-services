{
  "$schema": "https://unpkg.com/wrangler@4.151.0/config-schema.json",
  // Staff CRM screens (frontend/) on Cloudflare Workers. Lives at the repository root so the
  // Cloudflare Git build (build command `npm run build`, deploy command `npx wrangler deploy`) finds it.
  // The name must match the Worker connected to this repository in the Cloudflare dashboard.
  "name": "dk-lao-services",
  "main": "frontend/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // The Render service that now serves screens and API; this Worker only redirects to it.
    "BACKEND_URL": "https://dk-crm-web.onrender.com"
  },
  // No "migrations" block on purpose. The Worker was once deployed with the Containers option
  // (wrangler.containers.jsonc), which left a Durable Object class named CrmBackend behind; a
  // v1/v2 pair was added here to create and then delete it. `wrangler deploy` applied that, which
  // is why every build from main is Ready, and this Worker declares no Durable Object today.
  //
  // The pair had to go because Cloudflare builds a pull request with `wrangler versions upload`,
  // not `wrangler deploy`, and that command refuses any config carrying a migration:
  //
  //   This Worker has a pending Durable Object migration, which cannot be applied by
  //   `wrangler versions upload`. Durable Object migrations must be applied with `wrangler deploy`.
  //
  // So every PR build failed while every main build passed. `--dry-run` never caught it: the check
  // runs behind `isDryRun`, so it is skipped locally and only fires against the real API.
  "observability": { "enabled": true }
}
